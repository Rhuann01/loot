# ==============================================================================
# LOOT - VARIÁVEIS DE AMBIENTE (PRODUÇÃO / DESENVOLVIMENTO)
# ==============================================================================
# Nota: Credenciais operacionais (Token Apify, Chaves Shopee, Tag do ML e
# Grupo do WhatsApp) são configuradas DIRETAMENTE pelo Painel Web e salvas
# de forma segura e criptografada no banco SQLite.
#
# Este arquivo contém APENAS configurações de infraestrutura do servidor:
# ==============================================================================

# Ambiente de execução (development | production)
NODE_ENV=production

# Porta do servidor backend Express
PORT=3001

# Chave mestra de criptografia AES-256 (64 caracteres hexadecimais / 32 bytes)
# Usada para criptografar tokens e credenciais no SQLite.
# Gere uma nova com o comando:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY="sua_chave_hex_32_bytes_aqui"

# Credenciais de acesso ao Painel Web
# Em produção (NODE_ENV=production), defina uma senha forte diferente de admin.
PAINEL_USER=admin
PAINEL_SENHA=sua_senha_segura_aqui

# Origens permitidas para CORS (separadas por vírgula)
# Deixe vazio se o frontend for servido pelo próprio Express ou Caddy no mesmo domínio.
# Exemplo: https://meudominio.com.br
CORS_ORIGINS=""
