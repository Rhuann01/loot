# Exemplo de configuração Caddy para o Loot em produção
# O Caddy atua como proxy reverso com HTTPS automático via Let's Encrypt / ZeroSSL,
# encaminhando as requisições para o backend Node.js (que já serve tanto a API quanto o frontend compilado).
#
# Como usar:
# 1. Substitua "seu-dominio.com.br" pelo domínio real da aplicação.
# 2. Certifique-se de que o backend Node.js está em execução na porta 3001 (PORT=3001).
# 3. Certifique-se de que o build do frontend foi gerado em ./frontend/dist (npm run build no frontend).
# 4. Inicie o Caddy: caddy run --config Caddyfile.exemplo

seu-dominio.com.br {
    # Compactação eficiente de respostas
    encode zstd gzip

    # Cabeçalhos globais de segurança
    header {
        # Previne ataques de MIME sniffing
        X-Content-Type-Options "nosniff"
        # Previne clickjacking
        X-Frame-Options "DENY"
        # Política de referência restritiva
        Referrer-Policy "strict-origin-when-cross-origin"
        # Previne acesso indevido a recursos de câmera/microfone
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
        # Remove cabeçalho de identificação do servidor
        -Server
    }

    # Proxy reverso para o Express (porta 3001)
    # O Express já serve a API (/api/*) e os arquivos estáticos do frontend (frontend/dist)
    reverse_proxy localhost:3001 {
        # Repassa o IP real do cliente para o rate-limiting do backend
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
        header_up Host {host}

        # Configuração para Server-Sent Events (SSE - /api/whatsapp/events) sem buffering
        flush_interval -1
    }
}
